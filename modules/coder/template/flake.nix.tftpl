# This file is generated by the Coder microvm.nix template.
# Do not edit manually — it will be overwritten on the next workspace build.
# VM: ${vm_name}
#
# The microvm configuration follows the approach described by Michael
# Stapelberg in https://michael.stapelberg.ch/posts/2026-02-01-coding-agent-microvm-nix/
{
  description = "Coder workspace VM: ${vm_name}";

  inputs = {
    nixpkgs.url     = "github:NixOS/nixpkgs/${nixpkgs_ref}";
    # Pinned to the Coder server's nixpkgs revision so the `coder` agent binary
    # built here is the same version as the server (matched RPC API version).
    # The `coder-push-microvm-template` wrapper on the Coder server passes the
    # server's nixpkgs rev as the `coder_nixpkgs_rev` terraform variable. This
    # input deliberately does NOT follow `nixpkgs` above: it must track the
    # *server*, not whatever branch the workspace user picked for the rest of
    # the VM. `coder` is then taken from this input via an overlay (see below).
    nixpkgs-coder.url = "github:NixOS/nixpkgs/${coder_nixpkgs_rev}";
    microvm.url     = "github:microvm-nix/microvm.nix";
    microvm.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, nixpkgs-coder, microvm }:
  let
    system = "x86_64-linux";
    # Packages from the server's nixpkgs rev — used only to override `coder`
    # so the agent matches the server's version. `coder` is a prebuilt Go
    # binary fetched via fetchurl, so pulling it across nixpkgs revisions is
    # safe (no glibc/ABI coupling to the VM's own nixpkgs).
    #
    # Imported with `allowUnfree = true` (rather than via the default
    # `legacyPackages` accessor, which has unfree disabled) because `coder`
    # depends on `terraform`, which is unfree (bsl11) in the server's nixpkgs.
    # The VM's own `nixpkgs.config.allowUnfree = true` sets config for the *VM's*
    # nixpkgs input only — it does not propagate to this separate `nixpkgs-coder`
    # instance, so without this `terraform` fails to evaluate.
    coderPkgs = import nixpkgs-coder { inherit system; config.allowUnfree = true; };
  in {
    nixosConfigurations.${vm_name} = nixpkgs.lib.nixosSystem {
      inherit system;
      specialArgs = { inherit microvm; };
      modules = [
        microvm.nixosModules.microvm
        ({ config, lib, pkgs, ... }: {

          # ----------------------------------------------------------------
          # Pin `coder` to the server's version
          # ----------------------------------------------------------------
          # Override pkgs.coder with the one from nixpkgs-coder (the server's
          # nixpkgs rev, see the nixpkgs-coder input above) so the agent binary
          # matches the Coder server's version. Everything else in the VM stays
          # on the workspace user's chosen nixpkgs branch (the nixpkgs_ref
          # parameter) — only `coder` is pinned, since it's the one binary that
          # must speak the same RPC API as the server.
          nixpkgs.overlays = lib.mkAfter [
            (_: prev: { coder = coderPkgs.coder; })
          ];

          # ----------------------------------------------------------------
          # microvm hardware
          # ----------------------------------------------------------------
          microvm = {
            hypervisor = "${hypervisor}";
            vcpu       = ${vcpus};
            mem        = ${memory_mb};
            # Control socket for graceful shutdown (cloud-hypervisor).
            socket     = "control.socket";

            # Writable nix store overlay (tmpfs, ephemeral) so the nix-daemon
            # works. Lost on reboot — fine for a workspace VM.
            writableStoreOverlay = "/nix/.rw-store";

            shares = [
              {
                proto      = "virtiofs";
                tag        = "ro-store";
                source     = "/nix/store";
                mountPoint = "/nix/.ro-store";
              }
              {
                proto      = "virtiofs";
                tag        = "workspace";
                source     = "${workspace_dir}";
                mountPoint = "/home/${username}";
              }
              # Static host directory shared (read/write) into every workspace.
              # virtiofs passes the host's ownership straight through (no uid
              # remapping: virtiofsd runs as root but still reports each file's
              # real host owner, and the guest VFS checks perms against that), so
              # the share source must be writable by uid 1000 on the host. The
              # template's remote-exec (main.tf) creates it and chowns it to
              # 1000:1000 on every build — without that it stays root-owned and
              # the uid-1000 VM user can read but not write inside the VM.
              {
                proto      = "virtiofs";
                tag        = "host-shared";
                source     = "${shared_dir}";
                mountPoint = "/mnt/shared";
              }
            ];

            interfaces = [
              {
                type = "tap";
                id   = "${tap_id}";
                mac  = "${mac_address}";
              }
            ];

            # Persistent /var volume (system state across reboots).
            volumes = [
              {
                image      = "/var/lib/microvms/${vm_name}/var.img";
                mountPoint = "/var";
                size       = ${disk_gb * 1024};  # MiB
                autoCreate = true;
              }
            ];
          };

          # ----------------------------------------------------------------
          # Networking — systemd-networkd (proven in microvm.nix by
          # stapelberg). Match by wildcard "e*" so it works regardless of
          # whether the interface is named eth0, enp0s2, etc.
          # ----------------------------------------------------------------
          networking.hostName    = "${vm_name}";
          networking.useDHCP     = false;
          networking.useNetworkd = true;
          networking.tempAddresses = "disabled";
          networking.firewall.enable = false;

          # microvm.nix's initrd kernelModules list includes virtio_mmio,
          # virtio_pci, virtio_blk, virtiofs, 9p — but NOT virtio_net.
          # Without it the VM has no network interface.
          boot.initrd.kernelModules = [ "virtio_net" ];
          boot.kernelModules = [ "virtio_net" ];
#          boot.kernelPackages = pkgs.linuxPackages_6_12;

          systemd.network.enable = true;
          systemd.network.networks."10-e" = {
            matchConfig.Name = "e*";
            addresses = [ { Address = "${ip_address}/24"; } ];
            routes    = [ { Gateway = "${gateway}"; } ];
            # Per-link DNS + DefaultRoute so systemd-resolved actually sends
            # upstream queries out this interface. Without `DNSDefaultRoute`,
            # resolved flags the link `-DefaultRoute` ("Default Route: no" in
            # `resolvectl status") and refuses to route DNS through it even
            # though global servers are configured — so the 127.0.0.53 stub
            # has no usable upstream path and every lookup hangs until timeout.
            # Binding `DNS=` to the link (not just relying on the global
            # `networking.nameservers`) makes resolved treat this link as the
            # path to those servers. `DHCP = "no"` matches our static config.
            networkConfig = {
              DHCP = "no";
              DNSDefaultRoute = true;
            };
            dns = [ "1.1.1.1" "8.8.8.8" ];
          };

          networking.nameservers = [ "1.1.1.1" "8.8.8.8" ];

          # Resolve the Coder server's hostname inside the VM so the agent
          # can phone home without depending on public DNS.
          networking.hosts."${coder_server_ip}" = [ "${coder_server_hostname}" ];

          # ----------------------------------------------------------------
          # systemd tuning (from stapelberg's microvm-base.nix)
          # ----------------------------------------------------------------
          systemd.settings.Manager = {
            # Fast shutdowns/reboots.
            DefaultTimeoutStopSec = "5s";
          };

          # Fix for microvm shutdown hang (microvm.nix issue #170):
          # Without this, systemd tries to unmount /nix/store during shutdown,
          # but umount lives in /nix/store, causing a deadlock.
          systemd.mounts = [
            {
              what = "store";
              where = "/nix/store";
              overrideStrategy = "asDropin";
              unitConfig.DefaultDependencies = false;
            }
          ];

          # systemd-oomd needs memory.pressure cgroup support not available
          # in the minimal microvm kernel; its crash-loop destabilises D-Bus.
          systemd.oomd.enable = false;

          # nsncd (NixOS's default nscd, Type=notify) crash-loops in the
          # microvm because it can't signal readiness through the restricted
          # environment. It's requiredBy nss-lookup.target and
          # nss-user-lookup.target, so its failure blocks those targets and
          # anything that waits for them (including the coder-agent). Disable
          # it — NSS lookups go through glibc directly (files, dns), which is
          # fine for a workspace VM.
          services.nscd.enable = false;
          system.nssModules = lib.mkForce [];

          # ----------------------------------------------------------------
          # User account
          # ----------------------------------------------------------------
          users.groups.${username} = { gid = 1000; };
          users.users.${username} = {
            uid            = 1000;
            group          = "${username}";
            isNormalUser   = true;
            extraGroups    = [ "wheel" "nix-users" ];
            home           = "/home/${username}";
            hashedPassword = "!";
            # SSH public keys authorised to log into this workspace VM as the
            # workspace user. Filled from the template's `authorized_ssh_keys`
            # variable (newline-separated), which the
            # `coder-push-microvm-template` wrapper on elserver injects from
            # `coder.server.authorizedSshKeys` (default: the homelab key) —
            # so you can SSH in by jumping through the microvm host (see
            # modules/coder/README.md, "SSH access to workspace VMs").
            openssh.authorizedKeys.keys =
              builtins.filter (s: s != "")
                (lib.splitString "\n" "${authorized_ssh_keys}");
          };

          security.sudo.extraRules = [
            { users = [ "${username}" ]; commands = [ { command = "ALL"; options = [ "NOPASSWD" ]; } ]; }
          ];

          # ----------------------------------------------------------------
          # Nix daemon
          # ----------------------------------------------------------------
          nix.settings = {
            trusted-users         = [ "root" "${username}" ];
            experimental-features = [ "nix-command" "flakes" ];
            substituters          = [
              "https://cache.nixos.org"
              "https://microvm.cachix.org"
            ] ++ (if "${nix_cache_url}" != "" then [ "${nix_cache_url}" ] else []);
            trusted-public-keys   = [
              "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
              "microvm.cachix.org-1:oXnBc6hRE3eX5rSYdRyMYXnfzcCxC7yKPTbZXALsqys="
            ] ++ (if "${nix_cache_key}" != "" then [ "${nix_cache_key}" ] else []);
          };

          # ----------------------------------------------------------------
          # Coder agent
          # ----------------------------------------------------------------
          systemd.services.coder-agent = {
            description = "Coder workspace agent";
            wantedBy    = [ "multi-user.target" ];
            after       = [ "network-online.target" ];
            wants       = [ "network-online.target" ];
            environment = {
              CODER_AGENT_TOKEN = "${agent_token}";
              CODER_AGENT_URL   = "${coder_url}";
              HOME              = "/home/${username}";
            };
            serviceConfig = {
              User             = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${pkgs.coder}/bin/coder agent";
              Restart          = "on-failure";
              RestartSec       = "5s";
              Environment      = "PATH=/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin";
            };
          };

          # ----------------------------------------------------------------
          # code-server (VS Code in the browser, proxied via the agent)
          # ----------------------------------------------------------------
          # Runs as the workspace user, listening on loopback:3000 with
          # `--auth none` (the Coder dashboard's owner-scoped app proxy already
          # authenticates the user, so no second password). `--bind-127.0.0.1`
          # keeps it off the bridge subnet — only the agent (in this netns)
          # reaches it, and Coder proxies dashboard traffic through the agent
          # tunnel to this port. See the `coder_app "code-server"` in main.tf.
          #
          # HOME/WorkingDirectory point at /home/<user> (the virtiofs share
          # mounted from the host's /var/lib/coder-workspaces/<vm>), so VS
          # Code's config, extensions and open files persist across VM reboots.
          systemd.services.code-server = {
            description = "code-server (VS Code in the browser)";
            wantedBy    = [ "multi-user.target" ];
            environment = {
              HOME = "/home/${username}";
            };
            serviceConfig = {
              User             = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${pkgs.code-server}/bin/code-server --auth none --bind-addr=127.0.0.1:3000 /home/${username}";
              Restart          = "on-failure";
              RestartSec       = "5s";
              Environment      = "PATH=/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/home/${username}/.local/bin";
            };
          };

          # ----------------------------------------------------------------
          # SSH
          # ----------------------------------------------------------------
          services.openssh = {
            enable   = true;
            settings = {
              PasswordAuthentication = false;
              PermitRootLogin        = "no";
            };
          };

          # ----------------------------------------------------------------
          # System packages
          # ----------------------------------------------------------------
          environment.systemPackages = with pkgs; [
            coder git git-lfs
            code-server
            # filebrowser (web file manager) — baked in so the `module "filebrowser"`
            #   in main.tf finds it on the agent's PATH and skips its runtime
            #   curl|bash install (our agent PATH lacks /usr/local/bin).
            filebrowser
            vim nano curl wget htop jq ripgrep fd unzip gnumake git-crypt
          ] ++ (
            builtins.filter (p: p != null) (
              builtins.map
                (name: if builtins.hasAttr name pkgs then pkgs.$${name} else
                  builtins.trace "WARNING: unknown package $${name}" null)
                (builtins.filter (s: s != "")
                  (builtins.split " " "${extra_pkgs}"))
            )
          );

          # ----------------------------------------------------------------
          # Misc
          # ----------------------------------------------------------------
          time.timeZone              = "UTC";
          i18n.defaultLocale         = "en_US.UTF-8";
          system.stateVersion        = "24.11";
          nixpkgs.config.allowUnfree = true;
        })
      ];
    };
  };
}
