# This file is generated by the Coder microvm.nix template.
# Do not edit manually — it will be overwritten on the next workspace build.
# VM: ${vm_name}
#
# The microvm configuration follows the approach described by Michael
# Stapelberg in https://michael.stapelberg.ch/posts/2026-02-01-coding-agent-microvm-nix/
{
  description = "Coder workspace VM: ${vm_name}";

  inputs = {
    # Pinned to a fixed revision, NOT a branch. `pi-web`'s npmDepsHash is tied
    # to the `prefetch-npm-deps` implementation of the nixpkgs used to build it,
    # so a floating branch breaks the hash whenever it moves. Pinning the whole
    # VM nixpkgs makes the workspace build reproducible and lets the vendored
    # `pi-web/package.nix` keep its original npmDepsHash.
    nixpkgs.url     = "github:NixOS/nixpkgs/6aefcda9401be8acc2b74244fb3b37520ea1f0a8";
    microvm.url     = "github:microvm-nix/microvm.nix";
    microvm.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, microvm }:
  let
    system = "x86_64-linux";
  in {
    nixosConfigurations.${vm_name} = nixpkgs.lib.nixosSystem {
      inherit system;
      specialArgs = { inherit microvm; };
      modules = [
        microvm.nixosModules.microvm
        ({ config, lib, pkgs, ... }:
        let
          # PI WEB: web UI + persistent session manager for the Pi Coding
          # Agent. The package lives in `./pi-web/` next to this flake (written
          # by main.tf) and is built from the vendored npm derivation.
          piWeb = pkgs.callPackage ./pi-web/package.nix { };

          # OPENCODE 2.x: the OpenCode coding-agent CLI. nixpkgs only ships the
          # 1.x line, so the 2.x package lives in `./opencode/` next to this
          # flake (written by main.tf) and is built from the vendored prebuilt
          # binary there — see modules/coder/template/opencode-package.nix for
          # the why and the bump instructions.
          opencode = pkgs.callPackage ./opencode/package.nix { };

          # Password for the OpenCode server, plus the ready-made Basic header
          # its web UI has to send. `opencode serve` ALWAYS requires a password
          # (upstream generates a random one when none is supplied; there is no
          # "disable auth" mode) and the UI authenticates every /api call with
          # HTTP Basic. Coder's app proxy cannot inject request headers, so a
          # loopback nginx in front of the server does — see the nginx config
          # below. The value is a fixed literal on purpose: the server listens
          # on 127.0.0.1 only and the app sits behind Coder's owner-scoped
          # proxy, so this header is not a security boundary — it just satisfies
          # the server's own auth layer so the dashboard app opens without a
          # password prompt.
          opencodePassword  = "opencode-workspace-local";
          # base64("opencode:" + opencodePassword), spelled out because Nix has
          # no base64 builtin. Keep the two in sync when changing the password.
          opencodeBasicAuth = "b3BlbmNvZGU6b3BlbmNvZGUtd29ya3NwYWNlLWxvY2Fs";

          # Agent token on disk, readable only by the workspace user. See
          # `environment.etc."coder/agent-token"` below for why it's a file.
          agentTokenFile = "/etc/coder/agent-token";

          # Everything `coder gitssh` needs, plus the git hook that invokes it.
          #
          # `coder gitssh` fetches the workspace owner's Coder-managed Git SSH
          # key (GET /api/v2/workspaceagents/me/gitsshkey — an OSS endpoint, NOT
          # the Premium "External Authentication" feature), writes it to a temp
          # file and execs ssh with it. To reach that endpoint it authenticates
          # as the agent, so it needs CODER_AGENT_URL and the agent token.
          #
          # The Coder agent injects these into the shells IT spawns (dashboard
          # web terminal, `coder ssh`), but nothing else in the VM inherits
          # them: systemd unit environments are private to their own process
          # tree. So sshd logins, code-server terminals and pi-web sessions all
          # came up without them and `coder gitssh` failed. We set them
          # system-wide and per-unit instead.
          #
          # GIT_SSH_COMMAND mirrors upstream's exact form, including the `--`
          # and the host-key flags the agent itself appends — the temp key file
          # makes known_hosts churn pointless, and a StrictHostKeyChecking
          # prompt would hang non-interactive callers (pi-web's agent sessions).
          coderGitEnv = {
            CODER_AGENT_URL        = "${coder_url}";
            CODER_AGENT_TOKEN_FILE = agentTokenFile;
            GIT_SSH_COMMAND        =
              "$${pkgs.coder}/bin/coder gitssh -- -o UserKnownHostsFile=/dev/null -o StrictHostKeyChecking=no";
          };

          # Pi Coding Agent global defaults, materialized into the workspace
          # home by the `pi-agent-defaults` unit below. Kept in the Nix store
          # (writeText) so the unit can `install` real, user-owned copies:
          # PI WEB rewrites settings.json at runtime, which a /nix/store symlink
          # would defeat.
          #
          # `AGENTS.md` is Pi's global-instructions file: loaded into every
          # session, whichever project it runs in. `settings.json` is Pi's
          # global config; only the startup provider/model and the Relays
          # package PI WEB ships are pinned here (see the unit for why the
          # package is declared rather than left to auto-install).
          piAgentsMd = pkgs.writeText "pi-AGENTS.md"
            "When asked to generate code, please start a new branch off of main (after fetching) and push your changes there.\n";

          piSettingsJson = pkgs.writeText "pi-settings.json" (builtins.toJSON {
            defaultProvider = "opencode-go";
            defaultModel    = "deepseek-v4.1-flash";
            packages        = [ "$${piWeb}/lib/node_modules/pi-web/dist/pi-packages/relays" ];
          });
        in
        {

          # ----------------------------------------------------------------
          # Pin `coder` to the server's version
          # ----------------------------------------------------------------
          # `./coder-overlay.nix` is written next to this flake by the
          # template's main.tf — it is the SAME overlay the Coder server
          # applies to its own `pkgs` (modules/coder/server.nix), so the agent
          # binary is always the same pinned upstream release as the server.
          # Only `coder` is overridden; everything else in the VM uses the
          # pinned VM nixpkgs (see the `nixpkgs` input above).
          nixpkgs.overlays = lib.mkAfter [
            (import ./coder-overlay.nix)
          ];

          # ----------------------------------------------------------------
          # microvm hardware
          # ----------------------------------------------------------------
          microvm = {
            hypervisor = "${hypervisor}";
            vcpu       = ${vcpus};
            mem        = ${memory_mb};
            # Control socket for graceful shutdown (cloud-hypervisor).
            socket     = "control.socket";

            # Writable /nix/store overlay, so the nix-daemon can build inside
            # the VM. The upperdir is backed by the `nix-store.img` volume in
            # `volumes` below — NOT by the root tmpfs.
            #
            # It used to be a plain directory on the root tmpfs, and that ran
            # workspaces out of *inodes*: tmpfs caps them at RAM-pages / 2, so
            # a 2048 MiB VM got 262144 inodes for the whole root filesystem.
            # Nix store paths are tiny-file-dense — the pi-web path alone is
            # ~36k files for 533 MB — so a single in-VM build of anything
            # node- or python-shaped exhausted the cap at a few percent of the
            # nominal byte capacity. Backing it with a disk also stops store
            # writes from eating the VM's RAM, and keeps the build cache
            # across reboots.
            writableStoreOverlay = "/nix/.rw-store";

            shares = [
              {
                proto      = "virtiofs";
                tag        = "ro-store";
                source     = "/nix/store";
                mountPoint = "/nix/.ro-store";
              }
              {
                proto      = "virtiofs";
                tag        = "workspace";
                source     = "${workspace_dir}";
                mountPoint = "/home/${username}";
              }
              # Static host directory shared (read/write) into every workspace.
              # virtiofs passes the host's ownership straight through (no uid
              # remapping: virtiofsd runs as root but still reports each file's
              # real host owner, and the guest VFS checks perms against that), so
              # the share source must be writable by uid 1000 on the host. The
              # template's remote-exec (main.tf) creates it and chowns it to
              # 1000:1000 on every build — without that it stays root-owned and
              # the uid-1000 VM user can read but not write inside the VM.
              {
                proto      = "virtiofs";
                tag        = "host-shared";
                source     = "${shared_dir}";
                mountPoint = "/mnt/shared";
              }
            ];

            interfaces = [
              {
                type = "tap";
                id   = "${tap_id}";
                mac  = "${mac_address}";
              }
            ];

            # Persistent volumes (system state across reboots). Order matters:
            # microvm.nix assigns /dev/vdX by list position (lib.withDriveLetters,
            # no labels set here), so append new entries, never insert.
            volumes = [
              {
                image      = "/var/lib/microvms/${vm_name}/var.img";
                mountPoint = "/var";
                size       = ${disk_gb * 1024};  # MiB
                autoCreate = true;
              }
              # Writable /nix/store overlay upperdir. microvm.nix recognises a
              # volume whose mountPoint equals `writableStoreOverlay` and marks
              # it neededForBoot automatically (nixos-modules/microvm/mounts.nix).
              #
              # `-i 4096` sets one inode per 4 KiB instead of mke2fs's 16 KiB
              # default, quadrupling inode density for a filesystem that holds
              # almost nothing but small files. It costs ~6% of the volume for
              # the inode table. At the default 10 GiB that is ~2.6M inodes,
              # against the 262k the old tmpfs allowed.
              #
              # Changing `store_gb` does NOT resize this file in place: the
              # template's update provisioner deletes it (while the VM is
              # stopped) and the next start recreates it at the new size. That
              # discards built store paths, which is safe — sources live in the
              # virtiofs home/shared directories, not here.
              {
                image         = "/var/lib/microvms/${vm_name}/nix-store.img";
                mountPoint    = "/nix/.rw-store";
                size          = ${store_gb * 1024};  # MiB
                autoCreate    = true;
                fsType        = "ext4";
                mkfsExtraArgs = [ "-i" "4096" ];
              }
            ];
          };

          # ----------------------------------------------------------------
          # Networking — systemd-networkd (proven in microvm.nix by
          # stapelberg). Match by wildcard "e*" so it works regardless of
          # whether the interface is named eth0, enp0s2, etc.
          # ----------------------------------------------------------------
          networking.hostName    = "${vm_name}";
          networking.useDHCP     = false;
          networking.useNetworkd = true;
          networking.tempAddresses = "disabled";
          networking.firewall.enable = false;

          # microvm.nix's initrd kernelModules list includes virtio_mmio,
          # virtio_pci, virtio_blk, virtiofs, 9p — but NOT virtio_net.
          # Without it the VM has no network interface.
          boot.initrd.kernelModules = [ "virtio_net" ];
          boot.kernelModules = [ "virtio_net" ];
#          boot.kernelPackages = pkgs.linuxPackages_6_12;

          systemd.network.enable = true;
          systemd.network.networks."10-e" = {
            matchConfig.Name = "e*";
            addresses = [ { Address = "${ip_address}/24"; } ];
            routes    = [ { Gateway = "${gateway}"; } ];
            # Per-link DNS + DefaultRoute so systemd-resolved actually sends
            # upstream queries out this interface. Without `DNSDefaultRoute`,
            # resolved flags the link `-DefaultRoute` ("Default Route: no" in
            # `resolvectl status") and refuses to route DNS through it even
            # though global servers are configured — so the 127.0.0.53 stub
            # has no usable upstream path and every lookup hangs until timeout.
            # Binding `DNS=` to the link (not just relying on the global
            # `networking.nameservers`) makes resolved treat this link as the
            # path to those servers. `DHCP = "no"` matches our static config.
            networkConfig = {
              DHCP = "no";
              DNSDefaultRoute = true;
            };
            dns = [ "1.1.1.1" "8.8.8.8" ];
          };

          networking.nameservers = [ "1.1.1.1" "8.8.8.8" ];

          # Resolve the Coder server's hostname inside the VM so the agent
          # can phone home without depending on public DNS.
          networking.hosts."${coder_server_ip}" = [ "${coder_server_hostname}" ];

          # ----------------------------------------------------------------
          # systemd tuning (from stapelberg's microvm-base.nix)
          # ----------------------------------------------------------------
          systemd.settings.Manager = {
            # Fast shutdowns/reboots.
            DefaultTimeoutStopSec = "5s";
          };

          # Fix for microvm shutdown hang (microvm.nix issue #170):
          # Without this, systemd tries to unmount /nix/store during shutdown,
          # but umount lives in /nix/store, causing a deadlock.
          systemd.mounts = [
            {
              what = "store";
              where = "/nix/store";
              overrideStrategy = "asDropin";
              unitConfig.DefaultDependencies = false;
            }
          ];

          # systemd-oomd needs memory.pressure cgroup support not available
          # in the minimal microvm kernel; its crash-loop destabilises D-Bus.
          systemd.oomd.enable = false;

          # nsncd (NixOS's default nscd, Type=notify) crash-loops in the
          # microvm because it can't signal readiness through the restricted
          # environment. It's requiredBy nss-lookup.target and
          # nss-user-lookup.target, so its failure blocks those targets and
          # anything that waits for them (including the coder-agent). Disable
          # it — NSS lookups go through glibc directly (files, dns), which is
          # fine for a workspace VM.
          services.nscd.enable = false;
          system.nssModules = lib.mkForce [];

          # ----------------------------------------------------------------
          # User account
          # ----------------------------------------------------------------
          users.groups.${username} = { gid = 1000; };
          users.users.${username} = {
            uid            = 1000;
            group          = "${username}";
            isNormalUser   = true;
            extraGroups    = [ "wheel" "nix-users" ];
            home           = "/home/${username}";
            hashedPassword = "!";
            # SSH public keys authorised to log into this workspace VM as the
            # workspace user. Filled from the template's `authorized_ssh_keys`
            # variable (newline-separated), which the
            # `coder-push-microvm-template` wrapper on elserver injects from
            # `coder.server.authorizedSshKeys` (default: the homelab key) —
            # so you can SSH in by jumping through the microvm host (see
            # modules/coder/README.md, "SSH access to workspace VMs").
            openssh.authorizedKeys.keys =
              builtins.filter (s: s != "")
                (lib.splitString "\n" "${authorized_ssh_keys}");
          };

          security.sudo.extraRules = [
            { users = [ "${username}" ]; commands = [ { command = "ALL"; options = [ "NOPASSWD" ]; } ]; }
          ];

          # ----------------------------------------------------------------
          # Nix daemon
          # ----------------------------------------------------------------
          nix.settings = {
            trusted-users         = [ "root" "${username}" ];
            experimental-features = [ "nix-command" "flakes" ];
            substituters          = [
              "https://cache.nixos.org"
              "https://microvm.cachix.org"
            ] ++ (if "${nix_cache_url}" != "" then [ "${nix_cache_url}" ] else []);
            trusted-public-keys   = [
              "cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY="
              "microvm.cachix.org-1:oXnBc6hRE3eX5rSYdRyMYXnfzcCxC7yKPTbZXALsqys="
            ] ++ (if "${nix_cache_key}" != "" then [ "${nix_cache_key}" ] else []);
          };

          # The store overlay is a fixed-size volume now rather than a tmpfs
          # wiped on every boot, so nothing reclaims dead paths on its own.
          # Collect weekly and drop anything unreferenced for a fortnight.
          nix.gc = {
            automatic = true;
            dates     = "weekly";
            options   = "--delete-older-than 14d";
          };

          # NOT nix.optimise.automatic / nix.settings.auto-optimise-store:
          # microvm.nix asserts against both whenever writableStoreOverlay is
          # set (nixos-modules/microvm/system.nix), because hardlinking across
          # an overlayfs upperdir corrupts the store.

          # ----------------------------------------------------------------
          # Coder agent
          # ----------------------------------------------------------------
          systemd.services.coder-agent = {
            description = "Coder workspace agent";
            wantedBy    = [ "multi-user.target" ];
            after       = [ "network-online.target" ];
            wants       = [ "network-online.target" ];
            environment = {
              CODER_AGENT_TOKEN = "${agent_token}";
              CODER_AGENT_URL   = "${coder_url}";
              HOME              = "/home/${username}";
            };
            serviceConfig = {
              User             = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${pkgs.coder}/bin/coder agent";
              Restart          = "on-failure";
              RestartSec       = "5s";
              Environment      = "PATH=/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin";
            };
          };

          # ----------------------------------------------------------------
          # Git over SSH via `coder gitssh`
          # ----------------------------------------------------------------
          # The token as a file rather than an env var: CODER_AGENT_TOKEN_FILE
          # keeps the secret out of every child process's environ (visible in
          # /proc/<pid>/environ and in `ps -E`), and out of shell history when
          # someone dumps their env. It is NOT a full secret-hardening: the
          # token is still interpolated into this generated flake by main.tf and
          # therefore lands world-readable in the VM's /nix/store. Fixing that
          # properly means pushing the token to the microvm host out-of-band and
          # referencing the path from here instead of baking in the value.
          #
          # mode 0400 + user = the workspace user: the agent (which runs as that
          # user) and their shells can read it; nothing else in the VM can.
          environment.etc."coder/agent-token" = {
            text = "${agent_token}";
            mode = "0400";
            user = "${username}";
          };

          # Covers sshd logins (both the `coder_app "ssh"` external app and the
          # jump-host route) — NixOS writes these into /etc/profile, which login
          # shells source. Terminals spawned by code-server and pi-web do NOT
          # source it reliably (they inherit their unit's environment and often
          # spawn a non-login shell), so those two units get `coderGitEnv`
          # explicitly below.
          environment.sessionVariables = coderGitEnv;

          # ----------------------------------------------------------------
          # code-server (VS Code in the browser, proxied via the agent)
          # ----------------------------------------------------------------
          # Runs as the workspace user, listening on loopback:3000 with
          # `--auth none` (the Coder dashboard's owner-scoped app proxy already
          # authenticates the user, so no second password). `--bind-127.0.0.1`
          # keeps it off the bridge subnet — only the agent (in this netns)
          # reaches it, and Coder proxies dashboard traffic through the agent
          # tunnel to this port. See the `coder_app "code-server"` in main.tf.
          #
          # HOME/WorkingDirectory point at /home/<user> (the virtiofs share
          # mounted from the host's /var/lib/coder-workspaces/<vm>), so VS
          # Code's config, extensions and open files persist across VM reboots.
          systemd.services.code-server = {
            description = "code-server (VS Code in the browser)";
            wantedBy    = [ "multi-user.target" ];
            # `coderGitEnv` so integrated terminals and VS Code's own Git
            # integration — both children of this unit — can push over SSH.
            environment = coderGitEnv // {
              HOME = "/home/${username}";
            };
            serviceConfig = {
              User             = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${pkgs.code-server}/bin/code-server --auth none --bind-addr=127.0.0.1:3000 /home/${username}";
              Restart          = "on-failure";
              RestartSec       = "5s";
              Environment      = "PATH=/run/wrappers/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/home/${username}/.local/bin";
            };
          };

          # ----------------------------------------------------------------
          # PI WEB (Pi Coding Agent web UI + session daemon)
          # ----------------------------------------------------------------
          # Declarative equivalent of `pi-web install`'s per-user services:
          # `pi-web-sessiond` owns the unix socket under $HOME/.pi-web and
          # `pi-web-server` serves the UI on loopback:8504. Both run as the
          # workspace user with HOME on the persistent virtiofs share, so
          # projects/sessions survive VM reboots. main.tf exposes port 8504 as
          # the subdomain-based `pi-web` Coder app.
          #
          # PI_WEB_ALLOWED_HOSTS=true lets the app accept the Coder subdomain
          # Host header; the app is still behind Coder's owner-scoped proxy, so
          # it stays private to the workspace owner.
          systemd.services.pi-web-sessiond = {
            description = "PI WEB session daemon";
            wantedBy    = [ "multi-user.target" ];
            after       = [ "network-online.target" ];
            wants       = [ "network-online.target" ];
            # `coderGitEnv` too: the coding-agent sessions this daemon spawns
            # run git themselves, and they are children of this unit, not of
            # the Coder agent.
            environment = coderGitEnv // {
              HOME                 = "/home/${username}";
              PI_WEB_ALLOWED_HOSTS = "true";
            };
            serviceConfig = {
              User             = "${username}";
              Group            = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${piWeb}/bin/pi-web-sessiond";
              Environment      = "PATH=/run/current-system/sw/bin:/run/wrappers/bin";
              Restart          = "on-failure";
              RestartSec       = "2s";
            };
          };

          systemd.services.pi-web = {
            description = "PI WEB server";
            wantedBy    = [ "multi-user.target" ];
            after       = [ "pi-web-sessiond.service" "network-online.target" ];
            wants       = [ "pi-web-sessiond.service" "network-online.target" ];
            environment = {
              HOME                 = "/home/${username}";
              PI_WEB_HOST          = "127.0.0.1";
              PI_WEB_PORT          = "8504";
              PI_WEB_ALLOWED_HOSTS = "true";
            };
            serviceConfig = {
              User             = "${username}";
              Group            = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${piWeb}/bin/pi-web-server";
              Environment      = "PATH=/run/current-system/sw/bin:/run/wrappers/bin";
              Restart          = "on-failure";
              RestartSec       = "2s";
            };
          };

          # ----------------------------------------------------------------
          # OPENCODE 2.x (coding-agent web UI + auth-injecting proxy)
          # ----------------------------------------------------------------
          # `opencode serve` owns the sessions and serves the OpenCode web UI on
          # loopback:8511; nginx sits on loopback:8510 in front of it and stamps
          # the Basic header (see opencodeBasicAuth above) on every request,
          # including the SSE event feed and the WebSocket terminal upgrades.
          # main.tf exposes 8510 as the subdomain-based `opencode` Coder app, so
          # the dashboard reaches nginx through the agent tunnel and never talks
          # to the server directly.
          #
          # Runs as the workspace user with HOME on the persistent virtiofs
          # share, so sessions and the SQLite DB in ~/.local/share/opencode
          # survive VM reboots. `coderGitEnv` is inherited for the same reason
          # the pi-web units inherit it: the agent runs git itself.
          systemd.services.opencode = {
            description = "OpenCode 2.x server";
            wantedBy    = [ "multi-user.target" ];
            after       = [ "network-online.target" ];
            wants       = [ "network-online.target" ];
            environment = coderGitEnv // {
              HOME                     = "/home/${username}";
              OPENCODE_SERVER_PASSWORD = "$${opencodePassword}";
            };
            serviceConfig = {
              User             = "${username}";
              Group            = "${username}";
              WorkingDirectory = "/home/${username}";
              ExecStart        = "$${opencode}/bin/opencode serve --hostname 127.0.0.1 --port 8511";
              Restart          = "on-failure";
              RestartSec       = "2s";
              # The agent runs memory-hungry `nix` builds through its shell tool
              # inside this unit's cgroup. When one trips the kernel OOM killer,
              # the systemd default OOMPolicy=stop tears down the whole server,
              # aborting every in-flight session step ("Step interrupted"). With
              # OOMPolicy=continue only the OOM-killed child dies and the server
              # (and the user's sessions) survive.
              OOMPolicy        = "continue";
              Environment      = "PATH=/run/current-system/sw/bin:/run/wrappers/bin";
            };
          };

          # See the opencode service above for why this proxy exists.
          # proxyWebsockets turns on the Upgrade/Connection headers the
          # terminal attaches with; proxy_buffering off keeps the SSE event feed
          # flowing instead of being held in a buffer.
          services.nginx = {
            enable = true;
            virtualHosts."opencode" = {
              listen = [ { addr = "127.0.0.1"; port = 8510; } ];
              locations."/" = {
                proxyPass       = "http://127.0.0.1:8511";
                proxyWebsockets = true;
                extraConfig     = ''
                  proxy_set_header Host $host;
                  proxy_set_header Authorization "Basic $${opencodeBasicAuth}";
                  proxy_buffering off;
                  proxy_request_buffering off;
                  proxy_read_timeout 3600s;
                  proxy_send_timeout 3600s;
                '';
              };
            };
          };

          # ----------------------------------------------------------------
          # Pi Coding Agent defaults (global, every new session)
          # ----------------------------------------------------------------
          # Seeds Pi's global config into the persistent home share ($HOME is
          # the host-backed virtiofs mount, so it survives VM reboots). Runs as
          # the workspace user — not root — so the files land owned by 1000
          # without a chown across virtiofs, and before pi-web-sessiond so the
          # daemon never starts a session against a missing/stale config.
          #
          # This is the source of truth: the unit rewrites both files each time
          # it (re)starts, so a model picked in the web UI is a runtime
          # override, not a lasting one. `settings.json` also declares the
          # Relays package PI WEB would otherwise auto-install at sessiond
          # startup — declaring it makes that reconciliation a no-op, so it
          # does not immediately rewrite the file we just wrote.
          systemd.services.pi-agent-defaults = {
            description = "Seed Pi Coding Agent global defaults";
            wantedBy    = [ "multi-user.target" ];
            before      = [ "pi-web-sessiond.service" ];
            path        = [ pkgs.coreutils ];
            serviceConfig = {
              Type            = "oneshot";
              RemainAfterExit = true;
              User            = "${username}";
              Group           = "${username}";
            };
            script = ''
              install -d -m 0755 /home/${username}/.pi/agent
              install -m 0644 $${piAgentsMd} /home/${username}/.pi/agent/AGENTS.md
              install -m 0644 $${piSettingsJson} /home/${username}/.pi/agent/settings.json
            '';
          };

          # ----------------------------------------------------------------
          # SSH
          # ----------------------------------------------------------------
          services.openssh = {
            enable   = true;
            settings = {
              PasswordAuthentication = false;
              PermitRootLogin        = "no";
            };
          };

          # ----------------------------------------------------------------
          # System packages
          # ----------------------------------------------------------------
          environment.systemPackages = with pkgs; [
            coder git git-lfs
            code-server
            # Pi Coding Agent web UI + persistent session manager (see the
            # systemd services + Coder app).
            piWeb
            # OpenCode 2.x coding-agent CLI (`opencode` / `opencode2`), vendored
            # because nixpkgs only ships 1.x — see the `opencode` binding above.
            opencode
            # filebrowser (web file manager) — baked in so the `module "filebrowser"`
            #   in main.tf finds it on the agent's PATH and skips its runtime
            #   curl|bash install (our agent PATH lacks /usr/local/bin).
            filebrowser
            vim nano curl wget htop jq ripgrep fd unzip gnumake
            # python3 lands in /run/current-system/sw/bin, which is on the PATH
            # of the pi-web units below — so the coding agent's sessions can run
            # it without a `nix shell`. Per-project deps belong in a venv or a
            # project flake, not here.
            python3
          ] ++ (
            builtins.filter (p: p != null) (
              builtins.map
                (name: if builtins.hasAttr name pkgs then pkgs.$${name} else
                  builtins.trace "WARNING: unknown package $${name}" null)
                (builtins.filter (s: s != "")
                  (builtins.split " " "${extra_pkgs}"))
            )
          );

          # ----------------------------------------------------------------
          # Misc
          # ----------------------------------------------------------------
          time.timeZone              = "UTC";
          i18n.defaultLocale         = "en_US.UTF-8";
          system.stateVersion        = "24.11";
          nixpkgs.config.allowUnfree = true;
        })
      ];
    };
  };
}
